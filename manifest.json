{
  "manifest_version": 3,
  "name": "DropMunk",
  "version": "2.3",
  "description": "Dropmunk - Manage your downloads smartly",
  "icons": {
    "16": "icons/icon2.png",
    "32": "icons/icon2.png",
    "48": "icons/icon2.png",
    "128": "icons/icon2.png"
  },
  "permissions": [
    "downloads",
    "downloads.open"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Dropmunk ---Manage your downloads smartly",
    "default_icon": {
      "16": "icons/icon2.png",
      "32": "icons/icon2.png",
      "48": "icons/icon2.png",
      "128": "icons/icon2.png"
    },
    "default_popup": "popup.html"
  }
}